# Copy this file to `.env` before deployment.
# Fill only the values you need for the target network.

DEPLOYER_PRIVATE_KEY=
CREATOR_WALLET=
LOCALHOST_RPC_URL=http://127.0.0.1:8545
OPBNB_TESTNET_RPC_URL=
OPBNB_MAINNET_RPC_URL=

# Frontend/public RPC used by the web app.
# For localhost development keep the default value.
# For OPBNB testnet, change this to the same public RPC you want the frontend to read from.
VITE_PUBLIC_RPC_URL=http://127.0.0.1:8545

# This value is written automatically by the sync script after deployment.
VITE_METAGUILDX_SYSTEM_ADDRESS=
